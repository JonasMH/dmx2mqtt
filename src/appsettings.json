{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning"
    }
  },
  "MqttConnection": {
    "NodeId": "dmx2mqtt",
    "Server": "mosquitto",
    "Port": 1883
  },
  "Dmx": {
    "Device": "/dev/ttyUSB0",
    "Name": "Garage DMX",
    "FrameRate": 40,
    "Channels": 512,
    "FadeSeconds": 0.4,
    "Gamma": 2.2,
    "Fixtures": [
      {
        "Name": "Bar 1",
        "Address": 1,
        "Pixels": 8,
        "ColorOrder": "RGB"
      },
      {
        "Name": "Bar 2",
        "Address": 25,
        "Pixels": 8,
        "ColorOrder": "RGB"
      }
    ]
  },
  "Audio": {
    "Enabled": false,
    "Device": "",
    "LatencyMs": 60
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  }
}
