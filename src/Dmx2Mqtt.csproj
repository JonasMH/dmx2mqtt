<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<StaticallyLinked>true</StaticallyLinked>
	</PropertyGroup>
	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
		<!-- Link libc calls directly; a statically linked binary cannot dlopen libc -->
		<DirectPInvoke Include="libc" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Dmx2Mqtt.Test" />
		<!-- Served from the binary, so there is no wwwroot to deploy -->
		<EmbeddedResource Include="Display/index.html" LogicalName="index.html" />
	</ItemGroup>
	<!-- Microphone capture (src/Native). The Docker image links it in statically, -->
	<!-- otherwise it is loaded from next to the binary if it has been built. -->
	<ItemGroup Condition="'$(DmxAudioLibrary)' != ''">
		<DirectPInvoke Include="dmxaudio" />
		<NativeLibrary Include="$(DmxAudioLibrary)" />
		<NativeLibrary Include="$(AlsaLibrary)" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Native/**" />
		<None Include="Native/build/libdmxaudio.so" Link="libdmxaudio.so" CopyToOutputDirectory="PreserveNewest"
			Condition="'$(DmxAudioLibrary)' == '' And !$(RuntimeIdentifier.StartsWith('win')) And Exists('Native/build/libdmxaudio.so')" />
		<None Include="Native/build/dmxaudio.dll" Link="dmxaudio.dll" CopyToOutputDirectory="PreserveNewest"
			Condition="!$(RuntimeIdentifier.StartsWith('linux')) And Exists('Native/build/dmxaudio.dll')" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ToMqttNet" Version="6.0.1" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore"
			Version="1.20.1-beta.1" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
	</ItemGroup>
</Project>
